{
  "compilerOptions": {
    "target": "ES2023", "module": "ESNext", "moduleResolution": "Bundler", "jsx": "react-jsx",
    "lib": ["ES2023", "DOM", "DOM.Iterable"], "strict": true, "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true, "noImplicitOverride": true, "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true, "noUnusedParameters": true, "skipLibCheck": true,
    "allowImportingTsExtensions": true, "types": ["node", "vitest/globals"], "noEmit": true
  },
  "include": ["src", "scripts", "tests"]
}
