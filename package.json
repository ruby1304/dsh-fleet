{
  "name": "dsh-fleet",
  "version": "0.2.0",
  "description": "Declarative inventory and owner-approved plugin convergence for DeepSeek Harness fleets.",
  "type": "module",
  "main": "./index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./testing": "./testing.mjs",
    "./client": "./client.js",
    "./agent": "./agent.mjs",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "bin": {
    "dsh-fleet-agent": "./agent.mjs"
  },
  "files": [
    "index.mjs",
    "testing.mjs",
    "agent.mjs",
    "client.js",
    "client.js.map",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "SUPPORT.md",
    "CONTRIBUTING.md",
    "CODE_OF_CONDUCT.md",
    "THIRD_PARTY_NOTICES.md",
    "LICENSE",
    "docs",
    "examples/fleet.lock.yaml",
    "examples/agent.config.json"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ],
      "immediately": true
    }
  },
  "scripts": {
    "build": "node ./scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "check:generated": "node ./scripts/check-generated.mjs",
    "check:repository": "node ./scripts/repository-check.mjs",
    "check": "npm run typecheck && npm run test && npm run check:generated && npm run check:repository",
    "release:check": "npm run check && pnpm audit --prod --audit-level=high && npm pack --dry-run --ignore-scripts",
    "prepack": "npm run check"
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "fleet",
    "gitops",
    "device-management"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ruby1304/dsh-fleet.git"
  },
  "bugs": {
    "url": "https://github.com/ruby1304/dsh-fleet/issues"
  },
  "homepage": "https://github.com/ruby1304/dsh-fleet#readme",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "semver": "^7.8.5",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh": "0.1.0-rc.7",
    "@deepseek-ai/dsh-client-connection": "0.1.0-rc.7",
    "@deepseek-ai/dsh-host-apiproxy": "0.1.0-rc.7",
    "@types/node": "^24.10.0",
    "@types/react": "^18.3.0",
    "@types/react-test-renderer": "18.3.1",
    "@types/semver": "^7.8.0",
    "react": "^18.3.1",
    "react-test-renderer": "18.3.1",
    "tsdown": "^0.22.2",
    "typescript": "^5.9.3",
    "vitest": "^4.0.0"
  }
}
